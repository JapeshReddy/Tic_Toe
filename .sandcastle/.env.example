# --- Model provider: DeepSeek via its Anthropic-compatible endpoint ---
# The agent runs the Claude Code CLI, which speaks the Anthropic API. DeepSeek
# exposes a compatible endpoint, so we repoint the CLI rather than swap agents.
# Get a key at https://platform.deepseek.com/api_keys
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=

# Model mapping. ANTHROPIC_MODEL is the default; the DEFAULT_* vars catch any
# code path that asks for a Claude tier by name.
ANTHROPIC_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-flash

# Do NOT set CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY here — either one
# routes the agent back to Anthropic and defeats ANTHROPIC_BASE_URL above.
# To go back to Anthropic, delete this whole block and use one of them instead.

# GitHub personal access token — the agent uses it to read and manage GitHub Issues
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Issues (Read and write) and Metadata (Read)
GH_TOKEN=
